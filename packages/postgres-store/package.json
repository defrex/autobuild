{
  "name": "@defrex/autobuild-postgres-store",
  "version": "0.8.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./src/env.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    },
    "./store": {
      "types": "./src/store.ts",
      "import": "./src/store.ts"
    }
  },
  "bin": {
    "ab-postgres-store": "./src/bin.ts"
  },
  "peerDependencies": {
    "@defrex/autobuild": ">=0.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@vercel/blob": "^2.0.0"
  },
  "files": [
    "src",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/testing/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@defrex/autobuild": {
      "optional": true
    }
  }
}
