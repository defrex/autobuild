{
  "name": "autobuild",
  "version": "0.6.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "bin": {
    "ab": "bin/ab.ts"
  },
  "exports": {
    "./plugin-sdk": {
      "types": "./packages/core/src/plugin-sdk/index.ts",
      "import": "./packages/core/src/plugin-sdk/index.ts",
      "default": "./packages/core/src/plugin-sdk/index.ts"
    },
    "./remote-store": {
      "types": "./packages/core/src/store/remote/index.ts",
      "import": "./packages/core/src/store/remote/index.ts",
      "default": "./packages/core/src/store/remote/index.ts"
    }
  },
  "files": [
    "bin",
    "packages/core/src",
    "skills",
    "templates",
    "LICENSE",
    "README.md",
    "SPEC.md",
    "docs"
  ],
  "scripts": {
    "dev": "bun --hot --no-clear-screen bin/ab-dev.ts",
    "hosted-store": "bun server.ts",
    "capture:dashboard": "bun tools/dashboard-capture.ts",
    "capture:readme-headline": "bun tools/readme-headline.ts",
    "release": "bun tools/release.ts",
    "postgres:migrate": "bun packages/postgres-store/src/bin.ts migrate",
    "check": "bun tools/biome-check.ts && bun tools/product-name-check.ts && bun tools/docs-asset-check.ts && bun tools/readme-headline.ts --check && bun tools/workspace-manifest-check.ts",
    "format:staged": "git-format-staged --formatter './node_modules/.bin/biome format --stdin-file-path {}' '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.jsonc' '*.css' '*.graphql' '*.gql'",
    "prepare": "husky",
    "test": "bun test packages/*/src tools bin",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "semver": "^7.7.4",
    "smol-toml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.3.14",
    "@types/semver": "^7.7.1",
    "dejavu-fonts-ttf": "2.37.0",
    "drizzle-kit": "^0.31.10",
    "git-format-staged": "4.0.1",
    "husky": "9.1.7",
    "typescript": "^7.0.2"
  }
}
