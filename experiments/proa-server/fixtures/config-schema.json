              "claimedState": {
                "type": "optional",
                "inner": {
                  "type": "string",
                  "checks": [
                    {
                      "op": "min_length",
                      "minimum": 1
                    },
                    {
                      "op": "nonblank",
                      "error": "state must be nonblank",
                      "source": "(value) => value.trim().length > 0"
                    }
                  ]
                }
              },
              "doneState": {
                "type": "optional",
                "inner": {
                  "type": "string",
                  "checks": [
                    {
                      "op": "min_length",
                      "minimum": 1
                    },
                    {
                      "op": "nonblank",
                      "error": "state must be nonblank",
                      "source": "(value) => value.trim().length > 0"
                    }
                  ]
                }
              },
              "createState": {
                "type": "optional",
                "inner": {
                  "type": "string",
                  "checks": [
                    {
                      "op": "min_length",
                      "minimum": 1
                    },
                    {
                      "op": "nonblank",
                      "error": "state must be nonblank",
                      "source": "(value) => value.trim().length > 0"
                    }
                  ]
                }
              },
              "triageState": {
                "type": "optional",
                "inner": {
                  "type": "string",
                  "checks": [
                    {
                      "op": "min_length",
                      "minimum": 1
                    },
                    {
                      "op": "nonblank",
                      "error": "state must be nonblank",
                      "source": "(value) => value.trim().length > 0"
                    }
                  ]
                }
              },
              "proposalState": {
                "type": "optional",
                "inner": {
                  "type": "string",
                  "checks": [
                    {
                      "op": "min_length",
                      "minimum": 1
                    },
                    {
                      "op": "nonblank",
                      "error": "state must be nonblank",
                      "source": "(value) => value.trim().length > 0"
                    }
                  ]
                }
              },
              "dir": {
                "type": "optional",
                "inner": {
                  "type": "string",
                  "checks": [
                    {
                      "op": "min_length",
                      "minimum": 1
                    }
                  ]
                }
              }
            },
            "strict": true,
            "checks": [
              {
                "op": "tickets-cross"
              }
            ]
          },
          "transform": "tickets",
          "source": "(tickets) => ({\n  ...tickets,\n  readyState: tickets.readyState ?? \"ready\",\n  ...tickets.source === \"hosted\" && tickets.url !== void 0 ? { url: normalizeServiceURL(tickets.url, \"tickets.url\") } : {}\n})"
        },
        "default": {
          "source": "file"
        }
      }
    },
    "strict": true,
    "checks": [
      {
        "op": "root-cross"
      }
    ]
  },
  "vercel": {
    "type": "object",
    "properties": {
      "image": {
        "type": "default",
        "inner": {
          "type": "string",
          "checks": [
            {
              "op": "vercel-image",
              "error": "Autobuild Bun provisioning is validated only on the vercel/sandbox/universal managed image; use its bare name, a tag, or a sha256 digest containing exactly 64 lowercase hexadecimal characters",
              "source": "(image) => /^vercel\\/sandbox\\/universal(?::[A-Za-z0-9_][A-Za-z0-9._-]{0,127}|@sha256:[0-9a-f]{64})?$/.test(image)"
            }
          ]
        },
        "default": "vercel/sandbox/universal:latest"
      },
      "vcpus": {
        "type": "default",
        "inner": {
          "type": "number",
          "checks": [
            {
              "op": "number_format",
              "format": "safeint"
            },
            {
              "op": "greater_than",
              "value": 1,
              "inclusive": true
            },
            {
              "op": "less_than",
              "value": 32,
              "inclusive": true
            }
          ]
        },
        "default": 4
      },
      "timeoutSeconds": {
        "type": "number",
        "checks": [
          {
            "op": "number_format",
            "format": "safeint"
          },
          {
            "op": "greater_than",
            "value": 60,
            "inclusive": true
          },
          {
            "op": "less_than",
            "value": 86400,
            "inclusive": true
          }
        ]
      },
      "operationTimeoutMs": {
        "type": "default",
        "inner": {
          "type": "number",
          "checks": [
            {
              "op": "number_format",
              "format": "safeint"
            },
            {
              "op": "greater_than",
              "value": 1000,
              "inclusive": true
            },
            {
              "op": "less_than",
              "value": 300000,
              "inclusive": true
            }
          ]
        },
        "default": 30000
      },
      "snapshotExpirationSeconds": {
        "type": "optional",
        "inner": {
          "type": "number",
          "checks": [
            {
              "op": "number_format",
              "format": "safeint"
            },
            {
              "op": "greater_than",
              "value": 300,
              "inclusive": true
            },
            {
              "op": "less_than",
              "value": 2592000,
              "inclusive": true
            }
          ]
        }
      },
      "region": {
        "type": "optional",
        "inner": {
          "type": "string",
          "checks": [
            {
              "op": "min_length",
              "minimum": 1
            }
          ]
        }
      },
      "failoverRegions": {
        "type": "default",
        "inner": {
          "type": "array",
          "element": {
            "type": "string",
            "checks": [
              {
                "op": "min_length",
                "minimum": 1
              }
            ]
          }
        },
        "default": []
      },
      "environmentVariables": {
        "type": "default",
        "inner": {
          "type": "array",
          "element": {
            "type": "string",
            "checks": [
              {
                "op": "string_format",
                "error": "must be a nonblank environment variable name",
                "format": "regex",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "patternDisplay": "/^[A-Za-z_][A-Za-z0-9_]*$/"
              }
            ]
          }
        },
        "default": []
      },
      "provisioning": {
        "type": "default",
        "inner": {
          "type": "array",
          "element": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "checks": [
                  {
                    "op": "nonblank",
                    "error": "provisioning step name must be nonblank",
                    "source": "(value) => value.trim().length > 0"
                  }
                ]
              },
              "command": {
                "type": "string",
                "checks": [
                  {
                    "op": "nonblank",
                    "error": "provisioning step command must be nonblank",
                    "source": "(value) => value.trim().length > 0"
                  }
                ]
              }
            },
            "strict": true
          }
        },
        "default": []
      },
      "runtimeProvisioning": {
        "type": "map",
        "label": "[workspace.config.runtimeProvisioning]",
        "keys": "nonblank",
        "value": {
          "type": "object",
          "properties": {
            "install": {
              "type": "string",
              "checks": [
                {
                  "op": "nonblank",
                  "error": "install must be nonblank",
                  "source": "(value) => value.trim().length > 0"
                }
              ]
            },
            "preflight": {
              "type": "string",
              "checks": [
                {
                  "op": "nonblank",
                  "error": "preflight must be nonblank",
                  "source": "(value) => value.trim().length > 0"
                }
              ]
            }
          },
          "strict": true
        }
      },
      "gitUsernameEnv": {
        "type": "optional",
        "inner": {
          "type": "string",
          "checks": [
            {
              "op": "string_format",
              "error": "must be a nonblank environment variable name",
              "format": "regex",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "patternDisplay": "/^[A-Za-z_][A-Za-z0-9_]*$/"
            }
          ]
        }
      },
      "gitPasswordEnv": {
        "type": "optional",
        "inner": {
          "type": "string",
          "checks": [
            {
              "op": "string_format",
              "error": "must be a nonblank environment variable name",
              "format": "regex",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "patternDisplay": "/^[A-Za-z_][A-Za-z0-9_]*$/"
            }
          ]
        }
      }
    },
    "strict": true,
    "checks": [
      {
        "op": "vercel-cross"
      }
    ]
  },
