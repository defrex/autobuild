{
  "$schema": "https://proa.so/schema/proa.config.json",
  "application": {
    "binary": "proa-server",
    "kind": "site",
    "package": "proa-server",
    "starter": "blank",
    "template": "app"
  },
  "build": {
    "assets": [
      {
        "input": "styles/input.css",
        "kind": "tailwind",
        "output": "public/styles.css"
      }
    ],
    "before": [],
    "command": ["cargo", "build", "--release"]
  },
  "database": {
    "driver": "none"
  },
  "deploy": {
    "provider": "none"
  },
  "dev": {
    "before": [],
    "command": ["cargo", "run"],
    "watch": [
      "src",
      "styles",
      "migrations",
      "Cargo.toml",
      "build.rs",
      "proa.config.json",
      "proa.lock.json"
    ]
  },
  "paths": {
    "components": "src/components",
    "endpoints": "src/endpoints",
    "layouts": "src/layouts",
    "models": "src/models",
    "pages": "src/pages",
    "public": "public",
    "runtimeData": "data"
  },
  "registries": {
    "@proa": "https://ui.proa.so/r/{name}.json"
  },
  "representations": {
    "html": {
      "enabled": true
    },
    "markdown": {
      "enabled": true,
      "explicitSuffix": ".md",
      "negotiateOnCanonicalPath": true,
      "rootPath": "/index.md"
    }
  },
  "styling": {
    "input": "styles/input.css",
    "kind": "tailwind",
    "output": "public/styles.css"
  },
  "tasks": {},
  "test": {
    "before": []
  },
  "ui": {
    "provider": "none"
  }
}
