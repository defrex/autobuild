{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@defrex/autobuild/plugin-sdk": ["./packages/core/src/plugin-sdk/index.ts"],
      "@defrex/autobuild/remote-store": ["./packages/core/src/store/remote/index.ts"],
      "@defrex/autobuild/store-adapter": ["./packages/core/src/store/adapter.ts"],
      "@defrex/autobuild/testing": ["./packages/core/src/testing/index.ts"],
      "@defrex/autobuild/operator": ["./packages/core/src/operator/index.ts"],
      "@defrex/autobuild/operator-sandbox-host": ["./packages/core/src/operator/sandbox-host.ts"],
      "@defrex/autobuild/operator-presentation": ["./packages/core/src/operator/presentation.ts"],
      "@defrex/autobuild/hosted-tickets": ["./packages/core/src/ports/tickets/hosted-index.ts"],
      "@defrex/autobuild/ticket-update": ["./packages/core/src/ports/tickets/update.ts"],
      "@defrex/autobuild/origin": ["./packages/core/src/kernel/origin.ts"],
      "@defrex/autobuild/cli": ["./packages/core/src/cli/dispatch.ts"],
      "@defrex/autobuild/git-worktree": ["./packages/core/src/ports/workspace/git-worktree.ts"],
      "@defrex/autobuild/distribution": [
        "./packages/core/src/ports/workspace/distribution-archive.ts"
      ],
      "@defrex/autobuild-hosted-store-service": ["./packages/hosted-store-service/src/index.ts"],
      "@defrex/autobuild-hosted-store-service/service": [
        "./packages/hosted-store-service/src/service.ts"
      ],
      "@defrex/autobuild-hosted-store-service/web/auth": [
        "./packages/hosted-store-service/src/web/auth.ts"
      ],
      "@defrex/autobuild-hosted-store-service/web/config": [
        "./packages/hosted-store-service/src/web/config.ts"
      ],
      "@defrex/autobuild-hosted-store-service/web/client-name-policy": [
        "./packages/hosted-store-service/src/web/client-name-policy.ts"
      ],
      "@defrex/autobuild-hosted-store-service/web/runtime": [
        "./packages/hosted-store-service/src/web/runtime.ts"
      ],
      "@defrex/autobuild-hosted-store-service/operator-api": [
        "./packages/hosted-store-service/src/operator-api.ts"
      ],
      "@defrex/autobuild-hosted-store-service/remote-tickets": [
        "./packages/hosted-store-service/src/remote-tickets.ts"
      ],
      "@defrex/autobuild-hosted-dispatcher": ["./packages/hosted-dispatcher/src/index.ts"],
      "@defrex/autobuild-hosted-dispatcher/runtime": ["./packages/hosted-dispatcher/src/runtime.ts"]
    },
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "packages/*/src",
    "bin",
    "tools",
    "packages/hosted-store-service/server.ts",
    "drizzle.config.ts",
    "packages/hosted-store-service/app",
    "packages/hosted-store-service/.next/types/**/*.ts",
    "packages/hosted-store-service/.next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
